<?xml version="1.0" encoding="utf-8"?>
<!-- The now-playing panel (NowPlayingPanel): artwork, title, progress and the transport buttons. The panel
     background is set in code from the chosen interface style (UiStyle.panel). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/npPanel"
    android:layout_width="560dp"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="22dp">

    <ImageView
        android:id="@+id/npArt"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="22dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/npApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.18"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/npTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp"
            android:fontFamily="@string/font_regular" />

        <TextView
            android:id="@+id/npArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#CCFFFFFF"
            android:textSize="16sp"
            android:fontFamily="@string/font_regular" />

        <ProgressBar
            android:id="@+id/npProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="16dp"
            android:max="1000"
            android:focusable="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/npPrev"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="11dp"
                android:background="@drawable/ctrl_bg"
                android:src="@drawable/ic_skip_prev"
                android:tint="@drawable/pill_text"
                android:contentDescription="@string/np_previous"
                android:nextFocusRight="@+id/npPlay"
                android:focusable="true"
                android:clickable="true" />

            <ImageView
                android:id="@+id/npPlay"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginStart="12dp"
                android:padding="13dp"
                android:background="@drawable/ctrl_bg"
                android:src="@drawable/ic_pause"
                android:tint="@drawable/pill_text"
                android:contentDescription="@string/np_play_pause"
                android:nextFocusLeft="@+id/npPrev"
                android:nextFocusRight="@+id/npNext"
                android:focusable="true"
                android:clickable="true" />

            <ImageView
                android:id="@+id/npNext"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="12dp"
                android:padding="11dp"
                android:background="@drawable/ctrl_bg"
                android:src="@drawable/ic_skip_next"
                android:tint="@drawable/pill_text"
                android:contentDescription="@string/np_next"
                android:nextFocusLeft="@+id/npPlay"
                android:nextFocusRight="@+id/npOpen"
                android:focusable="true"
                android:clickable="true" />

            <ImageView
                android:id="@+id/npOpen"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="24dp"
                android:padding="12dp"
                android:background="@drawable/ctrl_bg"
                android:src="@drawable/ic_open_app"
                android:tint="@drawable/pill_text"
                android:contentDescription="@string/np_open_app"
                android:nextFocusLeft="@+id/npNext"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
