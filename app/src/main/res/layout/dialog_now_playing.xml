<?xml version="1.0" encoding="utf-8"?>
<!-- The now-playing card (NowPlayingPanel), laid out like the reference: artwork, title and artist, a sound-wave
     button (opens the app), the progress with a knob, and previous / play-pause / next. The card background is a
     LiquidGlassDrawable and the window behind it the blurred snapshot of Home, both set in code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/npRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/npCard"
        android:layout_width="620dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/npArt"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="20dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/npApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="@string/font_medium"
                    android:letterSpacing="0.18"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/npTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:textColor="#FFFFFFFF"
                    android:textSize="28sp"
                    android:fontFamily="@string/font_medium"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/npArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="#CCFFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="@string/font_regular"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <com.gathin.tvhome.EqualizerView
                android:id="@+id/npOpen"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/np_open_app"
                android:nextFocusDown="@+id/npSeek" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/npElapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:textColor="#CCFFFFFF"
                android:textSize="15sp"
                android:fontFeatureSettings="tnum"
                android:fontFamily="@string/font_regular" />

            <com.gathin.tvhome.KnobSeekView
                android:id="@+id/npSeek"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:nextFocusUp="@+id/npOpen"
                android:nextFocusDown="@+id/npPlay" />

            <TextView
                android:id="@+id/npTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:gravity="right"
                android:textColor="#CCFFFFFF"
                android:textSize="15sp"
                android:fontFeatureSettings="tnum"
                android:fontFamily="@string/font_regular" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:id="@+id/npPrev"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:padding="18dp"
                android:background="@drawable/ctrl_ghost_bg"
                android:src="@drawable/ic_fast_rewind"
                android:contentDescription="@string/np_previous"
                android:nextFocusRight="@+id/npPlay"
                android:focusable="true"
                android:clickable="true" />

            <ImageView
                android:id="@+id/npPlay"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginStart="34dp"
                android:layout_marginEnd="34dp"
                android:padding="26dp"
                android:background="@drawable/ctrl_ring_bg"
                android:src="@drawable/ic_pause"
                android:tint="@drawable/pill_text"
                android:contentDescription="@string/np_play_pause"
                android:nextFocusLeft="@+id/npPrev"
                android:nextFocusRight="@+id/npNext"
                android:nextFocusUp="@+id/npSeek"
                android:focusable="true"
                android:clickable="true" />

            <ImageView
                android:id="@+id/npNext"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:padding="18dp"
                android:background="@drawable/ctrl_ghost_bg"
                android:src="@drawable/ic_fast_forward"
                android:contentDescription="@string/np_next"
                android:nextFocusLeft="@+id/npPlay"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
