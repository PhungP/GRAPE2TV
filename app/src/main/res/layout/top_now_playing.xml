<?xml version="1.0" encoding="utf-8"?>
<!-- The now-playing pill (NowPlaying): title and artist of the app playing in the background; OK opens the
     NowPlayingPanel with the transport buttons. Hidden until a session exists. Added in code by MainActivity. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/btnNowPlaying"
    style="@style/TopButton"
    android:maxWidth="260dp"
    android:singleLine="true"
    android:ellipsize="end"
    android:drawableStart="@drawable/ic_music"
    android:nextFocusDown="@+id/grid"
    android:visibility="gone" />
