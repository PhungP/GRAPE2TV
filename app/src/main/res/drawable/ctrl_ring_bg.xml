<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#F2FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:type="linear" android:angle="270" android:startColor="#1FFFFFFF" android:endColor="#0DFFFFFF" />
            <stroke android:width="1.5dp" android:color="#80FFFFFF" />
        </shape>
    </item>
</selector>
