<?xml version="1.0" encoding="utf-8"?>
<!-- Rows of Launcher settings as glass chips: faint white, brighter with a light rim when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#47FFFFFF" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="#E6FFFFFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#3374C7FF" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#B374C7FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
        </shape>
    </item>
</selector>
